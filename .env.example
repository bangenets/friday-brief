# Optional keys only. Copy to .env — never commit .env.
# Mock mode (--mock) needs none of these and costs $0.

# Optional: OpenAI-compatible LLM endpoint for abstractive summaries.
# Without a key, FridayBrief uses extractive summarization (free, offline).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional: Keenable web search API (free credits for Agentware builders).
KEENABLE_API_KEY=
